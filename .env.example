# Spark Point Infotech Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase PostgreSQL Connection String
# Get URI from Supabase: Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Admin Authentication Secret
ADMIN_PASSWORD="SparkPoint2026!Admin"

# Optional Supabase API keys (if using client SDK)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
