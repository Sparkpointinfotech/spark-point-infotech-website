# Spark Point Infotech Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase PostgreSQL Connection String
# Get URI from Supabase: Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Admin Authentication Secret
ADMIN_PASSWORD="SparkPoint2026!Admin"

# JWT Signing Secret (REQUIRED in production — see server/middleware/auth.js)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-64-character-hex-string"

# Optional Supabase API keys (if using client SDK)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
